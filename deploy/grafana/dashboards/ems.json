        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT last(\"step\") FROM \"ems_metrics\" WHERE \"simulation_id\" = '${simulation_id}' AND \"generation\" = '${generation}'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2
        },
        "overrides": []
