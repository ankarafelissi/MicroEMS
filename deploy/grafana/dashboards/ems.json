{
  "id": null,
  "uid": "ems-dispatch",
  "title": "EMS Dispatch",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "editable": false,
  "refresh": "5s",
  "tags": [
    "ems"
  ],
  "time": {
    "from": "now/d",
    "to": "now/d+1d"
  },
