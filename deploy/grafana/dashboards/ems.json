      "10s",
      "30s",
      "1m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "simulation_id",
        "label": "Plan",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "ems-influx"
        },
        "query": "SHOW TAG VALUES FROM \"ems_simulations\" WITH KEY = \"simulation_id\"",
        "definition": "SHOW TAG VALUES FROM \"ems_simulations\" WITH KEY = \"simulation_id\"",
        "refresh": 2,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {},
        "sort": 0
      },
      {
        "name": "generation",
        "label": "Committed generation",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "ems-influx"
        },
        "query": "SELECT \"generation\" FROM \"ems_simulations\" WHERE \"simulation_id\" = '${simulation_id}'",
        "definition": "SELECT \"generation\" FROM \"ems_simulations\" WHERE \"simulation_id\" = '${simulation_id}'",
        "refresh": 2,
        "hide": 2,
